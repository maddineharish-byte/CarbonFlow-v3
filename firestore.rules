rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPlatformAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'PLATFORM_ADMIN' ||
        request.auth.token.email == 'maddineharish@gmail.com' ||
        request.auth.token.email == 'admin@carbonflow.io'
      );
    }

    function getUserDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function hasUserDoc(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function currentUserOrg() {
      return hasUserDoc(request.auth.uid) ? getUserDoc(request.auth.uid).organizationId : 'org-' + request.auth.uid;
    }

    function currentUserRole() {
      return hasUserDoc(request.auth.uid) ? getUserDoc(request.auth.uid).role : 'COMPANY_ADMIN';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper functions for entity validation
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'fullName', 'role']) &&
             data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 150 &&
             data.fullName is string && data.fullName.size() <= 100 &&
             data.role is string && data.role in ['COMPANY_ADMIN', 'SUSTAINABILITY_MANAGER', 'ANALYST', 'EMPLOYEE', 'AUDITOR'];
    }

    function isValidOrg(data) {
      return data.keys().hasAll(['id', 'name']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 150;
    }

    function isValidCarbonRecord(data) {
      return data.keys().hasAll(['id', 'organizationId', 'scope', 'category', 'activityAmount', 'unit']) &&
             data.id is string && data.id.size() <= 128 &&
             data.organizationId is string && data.organizationId.size() <= 128 &&
             data.scope is string && data.scope in ['SCOPE_1', 'SCOPE_2', 'SCOPE_3'] &&
             data.category is string && data.category.size() <= 100 &&
             (data.activityAmount is number || data.activityAmount is int) &&
             data.unit is string && data.unit.size() <= 50;
    }

    function isValidTravelActivity(data) {
      return data.keys().hasAll(['id', 'organizationId', 'originAddress', 'destinationAddress', 'totalDistanceKm', 'travelMode']) &&
             data.id is string && data.id.size() <= 128 &&
             data.organizationId is string && data.organizationId.size() <= 128 &&
             data.originAddress is string && data.originAddress.size() <= 200 &&
             data.destinationAddress is string && data.destinationAddress.size() <= 200 &&
             (data.totalDistanceKm is number || data.totalDistanceKm is int) &&
             data.travelMode is string && data.travelMode in ['DRIVE', 'TRANSIT', 'WALK', 'BICYCLE'];
    }

    function isValidEvidence(data) {
      return data.keys().hasAll(['id', 'organizationId', 'evidenceName', 'status']) &&
             data.id is string && data.id.size() <= 128 &&
             data.organizationId is string && data.organizationId.size() <= 128 &&
             data.evidenceName is string && data.evidenceName.size() <= 150 &&
             data.status is string && data.status in ['PENDING', 'VERIFIED', 'REJECTED'];
    }

    function isValidAudit(data) {
      return data.keys().hasAll(['id', 'organizationId', 'auditName', 'status']) &&
             data.id is string && data.id.size() <= 128 &&
             data.organizationId is string && data.organizationId.size() <= 128 &&
             data.auditName is string && data.auditName.size() <= 150 &&
             data.status is string && data.status in ['PLANNED', 'IN_PROGRESS', 'FIELDWORK_COMPLETE', 'REPORT_ISSUED', 'COMPLETED'];
    }

    // Healthcheck / Connection Verification Document
    match /test/{docId} {
      allow read: if true;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isPlatformAdmin() || resource.data.organizationId == currentUserOrg());
      allow list: if isSignedIn() && (resource.data.organizationId == currentUserOrg() || isPlatformAdmin());
      allow create: if isSignedIn() && (isOwner(userId) || isPlatformAdmin()) && isValidUser(incoming());
      // Prevent users from elevating their own role or jumping to another organization
      allow update: if isSignedIn() && (
        isPlatformAdmin() ||
        (isOwner(userId) && isValidUser(incoming()) && incoming().id == existing().id &&
         incoming().role == existing().role && incoming().organizationId == existing().organizationId) ||
        (currentUserRole() == 'COMPANY_ADMIN' && existing().organizationId == currentUserOrg() &&
         incoming().organizationId == existing().organizationId && isValidUser(incoming()) && incoming().id == existing().id)
      );
      allow delete: if isPlatformAdmin() || (currentUserRole() == 'COMPANY_ADMIN' && existing().organizationId == currentUserOrg() && !isOwner(userId));
    }

    // 2. Organizations Collection
    match /organizations/{orgId} {
      allow get: if isSignedIn() && (orgId == currentUserOrg() || isPlatformAdmin());
      allow list: if isSignedIn() && (resource.data.id == currentUserOrg() || isPlatformAdmin());
      allow create: if isSignedIn() && isValidOrg(incoming());
      allow update: if isSignedIn() && (orgId == currentUserOrg() || isPlatformAdmin()) && (currentUserRole() == 'COMPANY_ADMIN' || isPlatformAdmin()) && isValidOrg(incoming()) && incoming().id == existing().id;
      allow delete: if isPlatformAdmin();
    }

    // 3. Carbon Records Collection - Strict Tenant Isolation
    match /carbonRecords/{recordId} {
      allow get: if isSignedIn() && (resource.data.organizationId == currentUserOrg() || isPlatformAdmin());
      allow list: if isSignedIn() && (resource.data.organizationId == currentUserOrg() || isPlatformAdmin());
      allow create: if isSignedIn() && (incoming().organizationId == currentUserOrg() || isPlatformAdmin()) && isValidCarbonRecord(incoming()) && (currentUserRole() in ['COMPANY_ADMIN', 'SUSTAINABILITY_MANAGER', 'ANALYST'] || isPlatformAdmin());
      allow update: if isSignedIn() && (existing().organizationId == currentUserOrg() || isPlatformAdmin()) && incoming().organizationId == existing().organizationId && isValidCarbonRecord(incoming()) && (currentUserRole() in ['COMPANY_ADMIN', 'SUSTAINABILITY_MANAGER', 'ANALYST'] || isPlatformAdmin());
      allow delete: if isSignedIn() && (existing().organizationId == currentUserOrg() || isPlatformAdmin()) && (currentUserRole() in ['COMPANY_ADMIN', 'SUSTAINABILITY_MANAGER'] || isPlatformAdmin());
    }

    // 4. Travel Activities Collection - Strict Tenant Isolation
    match /travelActivities/{activityId} {
      allow get: if isSignedIn() && (resource.data.organizationId == currentUserOrg() || isPlatformAdmin());
      allow list: if isSignedIn() && (resource.data.organizationId == currentUserOrg() || isPlatformAdmin());
      allow create: if isSignedIn() && (incoming().organizationId == currentUserOrg() || isPlatformAdmin()) && isValidTravelActivity(incoming());
      allow update: if isSignedIn() && (existing().organizationId == currentUserOrg() || isPlatformAdmin()) && incoming().organizationId == existing().organizationId && isValidTravelActivity(incoming());
      allow delete: if isSignedIn() && (existing().organizationId == currentUserOrg() || isPlatformAdmin()) && (currentUserRole() in ['COMPANY_ADMIN', 'SUSTAINABILITY_MANAGER'] || isPlatformAdmin());
    }

    // 5. Evidence Collection - Strict Tenant Isolation
    match /evidence/{evidenceId} {
      allow get: if isSignedIn() && (resource.data.organizationId == currentUserOrg() || isPlatformAdmin());
      allow list: if isSignedIn() && (resource.data.organizationId == currentUserOrg() || isPlatformAdmin());
      allow create: if isSignedIn() && (incoming().organizationId == currentUserOrg() || isPlatformAdmin()) && isValidEvidence(incoming());
      allow update: if isSignedIn() && (existing().organizationId == currentUserOrg() || isPlatformAdmin()) && incoming().organizationId == existing().organizationId && isValidEvidence(incoming());
      allow delete: if isSignedIn() && (existing().organizationId == currentUserOrg() || isPlatformAdmin()) && (currentUserRole() in ['COMPANY_ADMIN', 'SUSTAINABILITY_MANAGER'] || isPlatformAdmin());
    }

    // 6. Audits Collection - Strict Tenant Isolation
    match /audits/{auditId} {
      allow get: if isSignedIn() && (resource.data.organizationId == currentUserOrg() || isPlatformAdmin());
      allow list: if isSignedIn() && (resource.data.organizationId == currentUserOrg() || isPlatformAdmin());
      allow create: if isSignedIn() && (incoming().organizationId == currentUserOrg() || isPlatformAdmin()) && isValidAudit(incoming()) && (currentUserRole() in ['COMPANY_ADMIN', 'SUSTAINABILITY_MANAGER', 'AUDITOR'] || isPlatformAdmin());
      allow update: if isSignedIn() && (existing().organizationId == currentUserOrg() || isPlatformAdmin()) && incoming().organizationId == existing().organizationId && isValidAudit(incoming()) && (currentUserRole() in ['COMPANY_ADMIN', 'SUSTAINABILITY_MANAGER', 'AUDITOR'] || isPlatformAdmin());
      allow delete: if isSignedIn() && (existing().organizationId == currentUserOrg() || isPlatformAdmin()) && (currentUserRole() == 'COMPANY_ADMIN' || isPlatformAdmin());
    }
  }
}
